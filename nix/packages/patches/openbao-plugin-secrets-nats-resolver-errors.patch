diff --git a/pkg/resolver/resolver_test.go b/pkg/resolver/resolver_test.go
new file mode 100644
index 0000000..688e1cf
--- /dev/null
+++ b/pkg/resolver/resolver_test.go
@@ -0,0 +1,94 @@
+package resolver
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/nats-io/nats.go"
+)
+
+func TestProcessResponse(t *testing.T) {
+	tests := []struct {
+		name        string
+		response    string
+		wantServer  string
+		wantError   string
+		nilResponse bool
+	}{
+		{
+			name:       "success",
+			response:   `{"server":{"name":"nats-01"},"data":{"message":"updated"}}`,
+			wantServer: "nats-01",
+		},
+		{
+			name:      "invalid json",
+			response:  `{`,
+			wantError: "failed to parse response",
+		},
+		{
+			name:      "missing server",
+			response:  `{"data":{"message":"updated"}}`,
+			wantError: "without a server name",
+		},
+		{
+			name:      "server error",
+			response:  `{"server":{"name":"nats-02"},"error":{"code":400,"description":"resolver unavailable"}}`,
+			wantError: "nats-02 responded with error code 400: resolver unavailable",
+		},
+		{
+			name:      "server error without info",
+			response:  `{"error":{"code":500,"description":"internal error"}}`,
+			wantError: "unknown responded with error code 500: internal error",
+		},
+		{
+			name:      "missing data",
+			response:  `{"server":{"name":"nats-03"}}`,
+			wantError: "nats-03 responded without data",
+		},
+		{
+			name:        "nil response",
+			wantError:   "empty response",
+			nilResponse: true,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var msg *nats.Msg
+			if !tt.nilResponse {
+				msg = &nats.Msg{Data: []byte(tt.response)}
+			}
+			server, data, err := processResponse(msg)
+			if tt.wantError != "" {
+				if err == nil || !strings.Contains(err.Error(), tt.wantError) {
+					t.Fatalf("expected error containing %q, got %v", tt.wantError, err)
+				}
+				if data != nil {
+					t.Fatalf("expected no data with error, got %#v", data)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("unexpected error: %v", err)
+			}
+			if server != tt.wantServer {
+				t.Fatalf("expected server %q, got %q", tt.wantServer, server)
+			}
+			got, ok := data.(map[string]interface{})
+			if !ok || got["message"] != "updated" {
+				t.Fatalf("unexpected response data: %#v", data)
+			}
+		})
+	}
+}
+
+func TestProcessResponseDoesNotIncludePayloadInParseError(t *testing.T) {
+	payload := `sensitive response payload`
+	_, _, err := processResponse(&nats.Msg{Data: []byte(payload)})
+	if err == nil {
+		t.Fatal("expected malformed response error")
+	}
+	if strings.Contains(err.Error(), payload) {
+		t.Fatalf("error leaked response payload: %v", err)
+	}
+}
