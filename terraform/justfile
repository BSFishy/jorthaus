# initialize the Authentik administrative Terraform root
[group('terraform')]
[working-directory: 'terraform/authentik-admin']
init-authentik-admin:
  tofu init

# plan Authentik RBAC administration using a human-admin API token supplied at runtime
[group('terraform')]
[working-directory: 'terraform/authentik-admin']
plan-authentik-admin:
  test -n "${AUTHENTIK_ADMIN_TOKEN:-}" || { echo 'Set AUTHENTIK_ADMIN_TOKEN to a human-admin API token.' >&2; exit 1; }
  AUTHENTIK_URL=https://auth.jort.haus AUTHENTIK_TOKEN="$AUTHENTIK_ADMIN_TOKEN" tofu plan

# apply Authentik RBAC administration using a human-admin API token supplied at runtime
[group('terraform')]
[working-directory: 'terraform/authentik-admin']
apply-authentik-admin:
  test -n "${AUTHENTIK_ADMIN_TOKEN:-}" || { echo 'Set AUTHENTIK_ADMIN_TOKEN to a human-admin API token.' >&2; exit 1; }
  AUTHENTIK_URL=https://auth.jort.haus AUTHENTIK_TOKEN="$AUTHENTIK_ADMIN_TOKEN" tofu apply

# import the existing Terraform service account, role, and current role permissions
[script]
[group('terraform')]
[working-directory: 'terraform/authentik-admin']
import-authentik-admin:
  set -euo pipefail
  : "${AUTHENTIK_ADMIN_TOKEN:?Set AUTHENTIK_ADMIN_TOKEN to a human-admin API token.}"
  export AUTHENTIK_URL=https://auth.jort.haus
  export AUTHENTIK_TOKEN="$AUTHENTIK_ADMIN_TOKEN"
  tofu init
  tofu import authentik_rbac_role.terraform_apps 58109253-db31-4f92-9d70-3a5843857341
  tofu import authentik_user.terraform 36
  permissions=$(mktemp)
  trap 'rm -f "$permissions"' EXIT
  curl --silent --show-error --fail --header "Authorization: Bearer $AUTHENTIK_TOKEN" \
    'https://auth.jort.haus/api/v3/rbac/permissions/roles/?uuid=58109253-db31-4f92-9d70-3a5843857341&page_size=100' \
    >"$permissions"
  jq -r '.results[] | select(.object_pk == null) | [.app_label, .codename, .id] | @tsv' "$permissions" \
    | while IFS=$'\t' read -r app_label codename id; do
        tofu import "authentik_rbac_permission_role.terraform_apps[\"$app_label.$codename\"]" "$id"
      done

# create the invitation-issuer API token and store it directly in OpenBao
[script]
[group('terraform')]
[working-directory: 'terraform/authentik-admin']
setup-invitation-issuer:
  set -euo pipefail
  : "${AUTHENTIK_ADMIN_TOKEN:?Set AUTHENTIK_ADMIN_TOKEN to a human-admin API token.}"
  user_id=$(tofu show -json | jq -er '.values.root_module.resources[] | select(.address == "authentik_user.invitation_issuer") | .values.id')
  token=$(curl --silent --show-error --fail --request POST \
    --header "Authorization: Bearer $AUTHENTIK_ADMIN_TOKEN" --header 'Content-Type: application/json' \
    --data "$(jq -nc --argjson user "$user_id" '{identifier: "jorthaus-invitation-issuer", intent: "api", user: $user, expiring: true}')" \
    'https://auth.jort.haus/api/v3/core/tokens/' >/dev/null; \
    curl --silent --show-error --fail --header "Authorization: Bearer $AUTHENTIK_ADMIN_TOKEN" \
      'https://auth.jort.haus/api/v3/core/tokens/jorthaus-invitation-issuer/view_key/' | jq -er '.key')
  printf '%s' "$token" | vault kv put -mount=authentik invitation-issuer token=-
  unset token

# create a single-use friend invitation that expires in 48 hours
[script]
[group('authentik')]
invite-friend name email='':
  set -euo pipefail
  token="$(vault kv get -mount=authentik -field=token invitation-issuer)"
  trap 'unset token' EXIT
  flow_uuid=$(tofu -chdir=terraform/apps state show authentik_flow.friend_enrollment | awk -F' = ' '$1 ~ /^[[:space:]]*uuid$/ {gsub(/"/, "", $2); print $2}')
  expires=$(date -u -d '+48 hours' '+%Y-%m-%dT%H:%M:%SZ')
  invitation_name="friend-$(printf '%s' '{{name}}' | tr '[:upper:] ' '[:lower:]-' | tr -cd 'a-z0-9-')-$(date -u '+%Y%m%d%H%M%S')"
  fixed_data=$(jq -nc --arg name '{{name}}' --arg email '{{email}}' 'if $email == "" then {name: $name} else {name: $name, email: $email} end')
  invitation_id=$(curl --silent --show-error --fail --request POST \
    --header "Authorization: Bearer $token" --header 'Content-Type: application/json' \
    --data "$(jq -nc --arg name "$invitation_name" --arg expires "$expires" --arg flow "$flow_uuid" --argjson fixed_data "$fixed_data" '{name: $name, expires: $expires, flow: $flow, fixed_data: $fixed_data, single_use: true}')" \
    'https://auth.jort.haus/api/v3/stages/invitation/invitations/' | jq -er '.pk')
  printf 'https://auth.jort.haus/if/flow/jorthaus-friend-enrollment/?itoken=%s\n' "$invitation_id"

# plan terraform changes for infra
[group('terraform')]
[working-directory: 'terraform/infra']
plan-infra:
  tofu plan

# apply terraform changes for infra
[group('terraform')]
[working-directory: 'terraform/infra']
apply-infra:
  tofu apply

# plan terraform changes for system
[group('terraform')]
[working-directory: 'terraform/system']
plan-system:
  TF_VAR_cloudflare_api_token="$CLOUDFLARE_API_TOKEN" tofu plan

# apply terraform changes for system
[group('terraform')]
[working-directory: 'terraform/system']
apply-system:
  TF_VAR_cloudflare_api_token="$CLOUDFLARE_API_TOKEN" tofu apply
