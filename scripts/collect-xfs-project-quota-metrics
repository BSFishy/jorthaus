#!/usr/bin/env python3
import argparse
import os
import re
import subprocess
import sys
import tempfile
import time
from pathlib import Path


PROJECT_NAME = re.compile(r"^[A-Za-z0-9_.-]+$")
INTEGER = re.compile(r"^[0-9]+$")


def quota_rows(report, expected_projects):
    rows = {}
    for line in report.splitlines():
        fields = line.split()
        if not fields or fields[0] not in expected_projects:
            continue
        if fields[0] in rows or len(fields) < 4:
            raise ValueError(f"invalid quota report row for {fields[0]}")
        if not INTEGER.fullmatch(fields[1]) or not INTEGER.fullmatch(fields[3]):
            raise ValueError(f"invalid block counts for {fields[0]}")
        used_blocks = int(fields[1])
        hard_blocks = int(fields[3])
        if hard_blocks <= 0:
            raise ValueError(f"project {fields[0]} has no hard quota")
        rows[fields[0]] = (used_blocks * 1024, hard_blocks * 1024)

    missing = expected_projects - rows.keys()
    if missing:
        raise ValueError(f"quota report is missing projects: {', '.join(sorted(missing))}")
    return rows


def render_metrics(filesystem, projects, rows, success):
    lines = [
        "# HELP jorthaus_xfs_project_quota_used_bytes XFS project quota usage in bytes.",
        "# TYPE jorthaus_xfs_project_quota_used_bytes gauge",
        "# HELP jorthaus_xfs_project_quota_hard_limit_bytes XFS project hard quota in bytes.",
        "# TYPE jorthaus_xfs_project_quota_hard_limit_bytes gauge",
        "# HELP jorthaus_xfs_project_quota_collector_success Whether all configured XFS project quotas were read successfully.",
        "# TYPE jorthaus_xfs_project_quota_collector_success gauge",
        "# HELP jorthaus_xfs_project_quota_collection_timestamp_seconds Unix timestamp of the last quota collection attempt.",
        "# TYPE jorthaus_xfs_project_quota_collection_timestamp_seconds gauge",
    ]
    escaped_filesystem = filesystem.replace("\\", "\\\\").replace('"', '\\"')
    if success:
        for project in sorted(projects):
            used_bytes, hard_limit_bytes = rows[project]
            labels = f'filesystem="{escaped_filesystem}",project="{project}"'
            lines.append(f"jorthaus_xfs_project_quota_used_bytes{{{labels}}} {used_bytes}")
            lines.append(f"jorthaus_xfs_project_quota_hard_limit_bytes{{{labels}}} {hard_limit_bytes}")
    lines.append(
        f'jorthaus_xfs_project_quota_collector_success{{filesystem="{escaped_filesystem}"}} {int(success)}'
    )
    lines.append(
        f'jorthaus_xfs_project_quota_collection_timestamp_seconds{{filesystem="{escaped_filesystem}"}} {time.time():.3f}'
    )
    return "\n".join(lines) + "\n"


def atomic_write(path, contents):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", suffix=".tmp", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as output:
            output.write(contents)
            output.flush()
            os.fsync(output.fileno())
        os.chmod(temporary, 0o644)
        os.replace(temporary, path)
    except BaseException:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("filesystem")
    parser.add_argument("output", type=Path)
    parser.add_argument("projects", nargs="+")
    args = parser.parse_args()

    projects = set(args.projects)
    if len(projects) != len(args.projects) or any(not PROJECT_NAME.fullmatch(name) for name in projects):
        parser.error("project names must be unique and contain only letters, digits, underscore, dot, or hyphen")

    success = False
    rows = {}
    try:
        result = subprocess.run(
            ["xfs_quota", "-x", "-c", "report -p -N", args.filesystem],
            check=True,
            capture_output=True,
            text=True,
        )
        rows = quota_rows(result.stdout, projects)
        success = True
    except (OSError, subprocess.CalledProcessError, ValueError) as error:
        print(f"xfs quota collection failed for {args.filesystem}: {error}", file=sys.stderr)

    atomic_write(args.output, render_metrics(args.filesystem, projects, rows, success))
    return 0 if success else 1


if __name__ == "__main__":
    raise SystemExit(main())
