#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
: "${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR must point to a private runtime directory}"
if [[ ! -d $XDG_RUNTIME_DIR || ! -O $XDG_RUNTIME_DIR || ! -w $XDG_RUNTIME_DIR ]]; then
  echo "XDG_RUNTIME_DIR is not a private writable directory" >&2
  exit 1
fi
if [[ $(stat -f -c '%T' "$XDG_RUNTIME_DIR") != tmpfs ]]; then
  echo "XDG_RUNTIME_DIR must be backed by tmpfs for credential creation" >&2
  exit 1
fi
export TMPDIR=$XDG_RUNTIME_DIR

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"
secret=secrets/k3s-datastore-password.age
identity=${HOME:?HOME is not set}/.ssh/id_ed25519

if [[ -e $secret ]]; then
  echo "Refusing to overwrite existing secret: $secret" >&2
  exit 1
fi
if [[ ! -r $identity ]]; then
  echo "Cannot read agenix identity: $identity" >&2
  exit 1
fi

created=1
cleanup() {
  status=$?
  trap - EXIT
  if (( status != 0 && created )); then
    rm -f -- "$secret"
  fi
  exit "$status"
}
trap cleanup EXIT

openssl rand -hex 32 | agenix -e "$secret" -i "$identity"
test -s "$secret"
agenix -d "$secret" -i "$identity" | tr -d '\r\n' | grep -Eq '^[0-9a-f]{64}$'
created=0
printf 'Created encrypted K3s datastore credential: %s\n' "$secret"
